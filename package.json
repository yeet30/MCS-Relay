{
  "name": "mcs-relay",
  "private": true,
  "version": "1.0.4",
  "description": "MCS-Relay: host a Minecraft server from a shared Google Drive, taking turns with friends",
  "author": "yeet30",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && vite build && electron-builder --win --publish never",
    "release": "npm run clean && tsc && vite build && electron-builder --win --publish always",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.yeet.mcsrelay",
    "productName": "MCS-Relay",
    "copyright": "Copyright © 2026 yeet30",
    "directories": {
      "output": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/launcher.ico"
    },
    "nsis": {
      "artifactName": "MCS-Relay-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yeet30",
        "repo": "MCS-Relay",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "~6.1.8"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "bottleneck": "^2.19.5",
    "chokidar": "^4.0.3",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^0.577.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.7",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zustand": "^5.0.12"
  },
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeet30/MCS-Relay.git"
  },
  "homepage": "https://mcs-relay.com/"
}
